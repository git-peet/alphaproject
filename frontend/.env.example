# Copy to .env and fill in real local values. Never commit .env.
#
# Required by backend/app/core/config.py (Settings):
PROJECT_NAME="Alpha Project"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database. Point the host at "db" inside docker compose, "localhost" when the
# backend runs on the host.
DATABASE_URL=postgresql+psycopg://postgres:changethis@localhost:5432/app

# Required by compose*.yml (stack name, proxy domain, database password):
STACK_NAME=alphaproject
DOMAIN=localhost
POSTGRES_PASSWORD=changethis

# Optional email (Mailpit in local development):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SENTRY_DSN=

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000
